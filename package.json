{
  "name": "anynote",
  "version": "0.1.0",
  "type": "module",
  "description": "A quiet, local-first personal knowledge garden",
  "author": "mxsyxin@gmail.com",
  "license": "MIT",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "package": "python3 scripts/rust-release.py build --dir",
    "package:release": "python3 scripts/rust-release.py build",
    "test:release:credentials": "python3 scripts/rust-release.py credentials",
    "test:release:native": "python3 scripts/test-rust-release.py",
    "build:browser": "node scripts/build-browser-extension.mjs",
    "build:worker": "node scripts/build-worker.mjs",
    "cloud:check": "pnpm run build:worker",
    "test:browser": "pnpm run build:browser && node scripts/browser-capture-smoke.mjs",
    "test:retained": "node scripts/test-retained.mjs",
    "test:retained:builds": "python3 scripts/check-retained-builds.py",
    "test:network": "node scripts/rust-network-acceptance.mjs",
    "test:network:local": "cargo build --locked -p anynote-services --example network_probe && node --test scripts/test-rust-network.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "husky",
    "dev": "cargo run --locked -p anynote-desktop",
    "desktop": "cargo run --locked -p anynote-desktop",
    "start": "cargo run --locked -p anynote-desktop",
    "build": "cargo build --locked -p anynote-desktop",
    "test": "cargo test --locked --workspace",
    "test:ts": "pnpm run build:browser && pnpm run build:worker && vitest run",
    "typecheck": "tsc --noEmit",
    "workspace:check": "python3 scripts/check-rust-workspace.py",
    "check": "pnpm run lint && pnpm run typecheck",
    "reference:prepare": "python3 scripts/legacy-reference.py prepare",
    "cloud:deploy": "pnpm run build:worker && node scripts/cloud-deploy.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261003.1",
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.55.1",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.19.0",
    "@types/turndown": "5.0.6",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "fflate": "0.8.2",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "playwright": "1.55.1",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.71.0",
    "vite": "6.3.6",
    "vitest": "4.1.11",
    "wrangler": "4.146.0",
    "yaml": "2.8.1",
    "zod": "3.25.76"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,jsx,tsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,jsonc,md,yml,yaml,css,html}": "prettier --write"
  },
  "private": true
}
