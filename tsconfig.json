{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "apps/desktop/src",
    "packages/types/src",
    "vite.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["**/node_modules", "**/dist"]
}
