[
  {
    "manifest": {
      "id": "garden.async-related",
      "name": "异步相关阅读索引",
      "version": "0.1.0",
      "engines": {
        "anynote": "^0.1.0"
      },
      "runtime": "quickjs-transform",
      "description": "查询当前 Notebook 的阅读记录，将命中标题及短片段追加到当前笔记。",
      "permissions": ["notes:read", "notes:write", "search:read"],
      "contributes": {
        "commands": [
          {
            "id": "garden.async-related.append",
            "title": "追加异步相关阅读索引",
            "action": {
              "kind": "transformMarkdown",
              "asyncSearch": [
                {
                  "query": "阅读记录",
                  "limit": 5,
                  "id": "reading"
                }
              ],
              "script": "async(note, host) => { const matches = await host.search('reading'); return note.body + '\\n\\n## 异步相关阅读索引\\n\\n' + (matches.results.length ? matches.results.map(r => '- ' + r.title + '：' + r.snippet.replace(/\\n/g, ' ')).join('\\n') : '未找到相关阅读记录。') + (matches.truncated ? '\\n更多结果已省略。' : '') + '\\n'; }"
            }
          }
        ],
        "editorNodes": []
      }
    },
    "checksum": "8783bf3111c3bef0c04ade1d19cea46e3c5fface503017853b40eae56a90c001"
  },
  {
    "manifest": {
      "id": "garden.reading",
      "name": "阅读卡片",
      "version": "0.1.0",
      "engines": {
        "anynote": "^0.1.0"
      },
      "runtime": "declarative",
      "description": "通过公开声明插入可编辑的阅读摘记与任务模板。",
      "permissions": ["notes:write"],
      "contributes": {
        "commands": [
          {
            "id": "garden.reading.insert",
            "title": "插入阅读卡片",
            "action": {
              "kind": "insertBlock",
              "type": "garden.reading.card"
            }
          },
          {
            "id": "garden.reading.template",
            "title": "插入阅读模板",
            "action": {
              "kind": "appendMarkdown",
              "body": "## 阅读摘记\n\n- [ ] 记录核心观点\n- [ ] 写下一个问题\n"
            }
          }
        ],
        "editorNodes": [
          {
            "type": "garden.reading.card",
            "title": "阅读卡片",
            "dataVersion": 1,
            "presentation": "callout",
            "fields": [
              {
                "key": "quote",
                "label": "摘录",
                "default": "记录值得留下的文字"
              },
              {
                "key": "thought",
                "label": "思考",
                "default": "我的理解"
              }
            ]
          }
        ]
      }
    },
    "checksum": "b60a3149228a1ba52ccf841dbbb71dddc45938a39298749a3d56d13a8b22904f"
  },
  {
    "manifest": {
      "id": "garden.network",
      "name": "公开资料摘要",
      "version": "0.1.0",
      "engines": {
        "anynote": "^0.1.0"
      },
      "runtime": "quickjs-transform",
      "description": "读取明确声明的公开文本地址并追加摘要；示例地址需替换为可用的公开服务。",
      "permissions": ["notes:read", "notes:write", "network"],
      "contributes": {
        "commands": [
          {
            "id": "garden.network.append",
            "title": "追加公开资料摘要",
            "action": {
              "kind": "transformMarkdown",
              "networkRequests": [
                {
                  "id": "reference",
                  "url": "https://example.com/anynote-demo.txt"
                }
              ],
              "script": "async (note, host) => { const response = await host.request('reference'); return note.body + '\\n\\n## 公开资料摘要\\n\\n' + response.text + '\\n'; }"
            }
          }
        ],
        "editorNodes": []
      }
    },
    "checksum": "a287e36b8eee720f93d6fd9f7dd8b94a32e80e4342f04a1a47648434bbd09edb"
  },
  {
    "manifest": {
      "id": "garden.preferences",
      "name": "可配置阅读摘要",
      "version": "0.1.1",
      "engines": {
        "anynote": "^0.1.0"
      },
      "runtime": "quickjs-transform",
      "description": "使用当前 Notebook 的设置，在笔记末尾追加阅读目标。",
      "permissions": [
        "notes:read",
        "notes:write",
        "settings:read",
        "settings:write"
      ],
      "contributes": {
        "settings": {
          "version": 1,
          "fields": [
            {
              "key": "heading",
              "label": "摘要标题",
              "kind": "text",
              "default": "阅读目标",
              "maxLength": 80
            },
            {
              "key": "goal",
              "label": "每周目标篇数",
              "kind": "number",
              "default": 3,
              "min": 1,
              "max": 100,
              "integer": true
            },
            {
              "key": "enabled",
              "label": "追加整理摘要",
              "kind": "boolean",
              "default": true
            }
          ]
        },
        "dataMigrations": [
          {
            "id": "garden.preferences.v2",
            "title": "阅读目标字段升级",
            "target": "settings",
            "fromVersion": 1,
            "toVersion": 1,
            "fromSettingsChecksum": "be3ae45e65a409b3d118007edec32f4629d338e714fa7ccbd851838ff1b04bbd",
            "rename": {
              "target": "goal"
            }
          }
        ],
        "commands": [
          {
            "id": "garden.preferences.append",
            "title": "按设置追加阅读目标",
            "action": {
              "kind": "transformMarkdown",
              "script": "(note)=>note.settings.enabled ? note.body+'\\n\\n## '+note.settings.heading+'\\n\\n目标：'+note.settings.goal+' 篇。\\n' : note.body"
            }
          }
        ],
        "editorNodes": []
      }
    },
    "checksum": "f3824102788da09f05016b69aac2cfc05e1a1f137c43f505857ca718b3258536"
  },
