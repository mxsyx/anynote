  {
    "manifest": {
      "id": "garden.related",
      "name": "相关阅读索引",
      "version": "0.1.0",
      "engines": {
        "anynote": "^0.1.0"
      },
      "runtime": "quickjs-transform",
      "description": "查询当前 Notebook 的阅读记录，将命中标题及短片段追加到当前笔记。",
      "permissions": ["notes:read", "notes:write", "search:read"],
      "contributes": {
        "commands": [
          {
            "id": "garden.related.append",
            "title": "追加相关阅读索引",
            "action": {
              "kind": "transformMarkdown",
              "searchContext": {
                "query": "阅读记录",
                "limit": 5
              },
              "script": "(note) => note.body + '\\n\\n## 相关阅读索引\\n\\n' + (note.searchContext.results.length ? note.searchContext.results.map(r => '- ' + r.title + '：' + r.snippet.replace(/\\n/g, ' ')).join('\\n') : '未找到相关阅读记录。') + (note.searchContext.truncated ? '\\n更多结果已省略。' : '') + '\\n'"
            }
          }
        ],
        "editorNodes": []
