              "kind": "number",
              "default": 3,
              "min": 1,
              "max": 100,
              "integer": true
            },
            {
              "key": "enabled",
              "label": "追加整理摘要",
              "kind": "boolean",
              "default": true
            }
          ]
        },
        "dataMigrations": [
          {
            "id": "garden.preferences.v2",
            "title": "阅读目标字段升级",
            "target": "settings",
            "fromVersion": 1,
            "toVersion": 1,
            "fromSettingsChecksum": "be3ae45e65a409b3d118007edec32f4629d338e714fa7ccbd851838ff1b04bbd",
            "rename": {
              "target": "goal"
            }
          }
        ],
        "commands": [
          {
            "id": "garden.preferences.append",
            "title": "按设置追加阅读目标",
