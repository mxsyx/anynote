{
  "name": "@anynote/first-party-adapters",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*.js": {
      "types": "./src/*.ts",
      "import": "./dist/*.js"
    },
    "./package.json": "./package.json",
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./dist/*.js"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "node ../../scripts/build-workspace.mjs packages/first-party-adapters",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anynote/plugin-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
