{
  "name": "@anynote/importer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*.js": {
      "types": "./src/*.ts",
      "import": "./dist/*.js"
    },
    "./package.json": "./package.json",
    "./*": {
      "types": "./src/*.ts",
      "import": "./dist/*.js"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "node ../../scripts/build-retained.mjs browser && node ../../scripts/build-retained.mjs worker",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anynote/protocol": "workspace:*",
    "dompurify": "3.2.7",
    "turndown": "7.2.0"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "24.19.0",
    "@types/turndown": "5.0.6",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
