{
  "name": "@anynote/protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*.js": {
      "types": "./src/*.ts",
      "import": "./dist/*.js"
    },
    "./package.json": "./package.json",
    "./operations.json": "./dist/operations.json",
    "./*": {
      "types": "./src/*.ts",
      "import": "./dist/*.js"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "node ../../scripts/build-workspace.mjs packages/protocol",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anynote/types": "workspace:*",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.0",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
