{
  "name": "@anynote/storage-sqlite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*.js": {
      "types": "./src/*.ts",
      "import": "./dist/*.js"
    },
    "./package.json": "./package.json",
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./dist/*.js"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "node ../../scripts/build-workspace.mjs packages/storage-sqlite",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anynote/backup": "workspace:*",
    "@anynote/extension-tools": "workspace:*",
    "@anynote/importer": "workspace:*",
    "@anynote/plugin-sdk": "workspace:*",
    "@anynote/protocol": "workspace:*",
    "@anynote/types": "workspace:*",
    "fflate": "0.8.2",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
