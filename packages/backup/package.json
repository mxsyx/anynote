{
  "name": "@anynote/backup",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*.js": {
      "types": "./src/*.ts",
      "import": "./dist/*.js"
    },
    "./package.json": "./package.json",
    "./*": {
      "types": "./src/*.ts",
      "import": "./dist/*.js"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "node ../../scripts/build-workspace.mjs packages/backup",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anynote/cloudflare-backup": "workspace:*",
    "@anynote/protocol": "workspace:*",
    "@anynote/storage-sqlite": "workspace:*",
    "@anynote/types": "workspace:*",
    "@aws-sdk/client-s3": "3.888.0",
    "fflate": "0.8.2",
    "zod": "3.25.76",
    "@anynote/backup-local": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
