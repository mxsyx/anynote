# Copy to .env.cloud (ignored by git). Do not commit real credentials.
# Cloudflare: run pnpm run cloud:deploy; these are optional for an existing Worker.
# ANYNOTE_CF_ENDPOINT=https://YOUR_WORKER.workers.dev
# ANYNOTE_CF_TOKEN=
ANYNOTE_S3_ENDPOINT=https://YOUR_S3_ENDPOINT
ANYNOTE_S3_BUCKET=
ANYNOTE_S3_REGION=us-east-1
ANYNOTE_S3_PATH_STYLE=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional for temporary AWS credentials:
AWS_SESSION_TOKEN=

# Alibaba OSS (example: Hangzhou) requires S3 endpoint + virtual-hosted addressing:
# ANYNOTE_S3_ENDPOINT=https://s3.oss-cn-hangzhou.aliyuncs.com
# ANYNOTE_S3_REGION=cn-hangzhou
# ANYNOTE_S3_PATH_STYLE=false

# Optional independent second S3 implementation (never falls back to primary OSS):
ANYNOTE_S3_SECOND_ENDPOINT=
ANYNOTE_S3_SECOND_BUCKET=
ANYNOTE_S3_SECOND_REGION=
ANYNOTE_S3_SECOND_PATH_STYLE=true
ANYNOTE_S3_SECOND_ACCESS_KEY_ID=
ANYNOTE_S3_SECOND_SECRET_ACCESS_KEY=
# ANYNOTE_S3_SECOND_SESSION_TOKEN=
# Or run local MinIO acceptance with --binary /path/to/minio.
