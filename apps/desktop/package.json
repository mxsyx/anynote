{
  "name": "@anynote/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*.js": {
      "types": "./*.ts",
      "import": "./dist/*.js"
    },
    "./package.json": "./package.json",
    "./*": {
      "types": "./*.ts",
      "import": "./dist/*.js"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "pnpm --dir ../.. run build",
    "typecheck": "tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.json --noEmit",
    "build:renderer": "pnpm --dir ../.. exec vite build --config vite.config.ts",
    "dev": "pnpm --dir ../.. run desktop",
    "start": "pnpm --dir ../.. start",
    "package": "pnpm --dir ../.. run package"
  },
  "dependencies": {
    "@anynote/backup": "workspace:*",
    "@anynote/backup-core": "workspace:*",
    "@anynote/plugin-sdk": "workspace:*",
    "@anynote/protocol": "workspace:*",
    "@anynote/storage-sqlite": "workspace:*",
    "@anynote/types": "workspace:*",
    "@codemirror/lang-markdown": "6.3.3",
    "@codemirror/search": "6.5.11",
    "@excalidraw/excalidraw": "0.18.0",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/extension-task-item": "3.31.4",
    "@tiptap/extension-task-list": "3.31.4",
    "@tiptap/markdown": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@uiw/react-codemirror": "4.25.3",
    "lucide-react": "0.468.0",
    "pdfjs-dist": "5.4.149",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "@anynote/extension-host": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "41.9.1",
    "electron-builder": "26.0.12",
    "typescript": "5.9.2",
    "vite": "6.3.6"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "../../.build/apps/desktop/electron/main.cjs",
  "build": {
    "appId": "app.anynote.desktop",
    "productName": "Anynote",
    "files": [
      "dist/**/*",
      ".build/**/*",
      "package.json"
    ],
    "linux": {
      "target": "AppImage"
    },
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "directories": {
      "output": "release"
    },
    "electronDist": "node_modules/electron/dist"
  }
}
